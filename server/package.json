{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun nitro dev --port 4000",
    "build": "nitro build",
    "preview": "node .output/server/index.mjs",
    "dev:e2e": "NITRO_PRESET=node-server bun run build && PORT=4001 VETISUITE_API_DOMAIN=http://localhost:4001 VETISUITE_APP_DOMAIN=http://localhost:3001 bun .output/server/index.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "deltas:launch": "bun --env-file=.env.local --env-file=.env ./migrations/launch.js"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1088.0",
    "@aws-sdk/client-s3": "3.1088.0",
    "@aws-sdk/client-sqs": "3.1088.0",
    "@aws-sdk/lib-dynamodb": "3.1088.0",
    "@aws-sdk/s3-presigned-post": "3.1088.0",
    "@aws-sdk/s3-request-presigner": "3.1088.0",
    "@vetisuite/database": "workspace:*",
    "bcrypt": "6.0.0",
    "date-fns": "4.4.0",
    "dotenv": "17.4.2",
    "endpoint-permissions-kit": "0.3.0",
    "fast-glob": "3.3.3",
    "h3": "^1.15.0",
    "nitropack": "2.13.4",
    "slugify": "1.6.9",
    "underscore": "1.13.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.10",
    "vitest": "4.1.10"
  }
}
