{
  "name": "@vetisuite/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./db": "./src/db.ts",
    "./orm": "./src/orm.ts",
    "./postgres": "./src/postgres.ts",
    "./schemas": "./src/schemas/schemas.ts",
    "./*.js": "./src/*.ts"
  },
  "scripts": {
    "build": "echo no build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "drizzle:migrate:generate": "drizzle-kit generate",
    "drizzle:migrate:apply": "drizzle-kit migrate",
    "drizzle:migrate:check": "drizzle-kit check",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@types/node": "^22.20.3",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2"
  }
}
