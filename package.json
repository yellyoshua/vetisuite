{
  "name": "vetisuite",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "landing",
    "server",
    "packages/*",
    "cloudtasks",
    "cloudtasks/*"
  ],
  "scripts": {
    "dev": "bun run --filter client dev",
    "dev:setup": "bash start-local-development.sh",
    "dev:server": "bun --cwd server dev",
    "build": "bun run --filter '*' build",
    "build:server": "bun --cwd server build",
    "test:client": "bun --cwd client test",
    "test:server": "bun --cwd server test",
    "test": "bun --cwd client test && bun --cwd server test",
    "lint": "eslint .",
    "typecheck": "bun run --filter '*' typecheck",
    "db:generate": "bun run --filter @vetisuite/database db:generate",
    "db:migrate": "bun run --filter @vetisuite/database db:migrate",
    "drizzle:migrate:generate": "bun --cwd packages/database drizzle:migrate:generate",
    "drizzle:migrate:apply": "bun --cwd packages/database drizzle:migrate:apply",
    "drizzle:migrate:check": "bun --cwd packages/database drizzle:migrate:check",
    "deltas:launch": "bun --cwd server deltas:launch",
    "seeds:restore": "sh seeds/restore.sh",
    "seeds:export": "sh seeds/export.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript-eslint": "^8.62.0"
  }
}
